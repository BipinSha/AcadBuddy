<article class="card article-card">
  {% if post.data.featuredImage %}<img src="{{ post.data.featuredImage }}" alt="" loading="lazy">{% endif %}
  <div class="card-body">
    {% if post.data.categories and post.data.categories[0] %}<span class="eyebrow">{{ post.data.categories[0] }}</span>{% endif %}
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
    {% if post.date %}<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>{% endif %}
  </div>
</article>
